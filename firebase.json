{
  "firestore": {
    "rules": "firestore.rules"
  },
  "auth": {
    "providers": {
      "emailPassword": {
        "enabled": true
      }
    }
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "creance-firestore.rules.txt",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}
