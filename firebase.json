{
  "firestore": {
    "rules": "firestore.rules"
  },
  "auth": {
    "providers": {
      "emailPassword": {
        "enabled": true
      }
    }
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "creance-firestore.rules.txt",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/creance.html",
        "destination": "/index.html",
        "type": 301
      },
      {
        "source": "/manifest.json",
        "destination": "/manifest.webmanifest",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Service-Worker-Allowed",
            "value": "/"
          }
        ]
      },
      {
        "source": "/**/*.{webmanifest,json}",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ]
  }
}
