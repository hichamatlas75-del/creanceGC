rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function isCaisse() {
      return request.auth != null && (
        request.auth.token.email == 'caisse@greycorner.app' ||
        (exists(/databases/$(db)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'caisse')
      );
    }

    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isCaisse());
      allow create: if request.auth != null && (
        (request.auth.uid == uid && request.resource.data.role == 'client') ||
        isCaisse()
      );
      allow update: if isCaisse();
    }

    match /transactions/{id} {
      allow read: if request.auth != null &&
        (resource.data.clientId == request.auth.uid || isCaisse());
      
      // Sécurisation stricte de la création : contrôle du type, statut, et montant
      allow create: if request.auth != null && (
        isCaisse() ||
        (request.resource.data.clientId == request.auth.uid
          && request.resource.data.type == 'commande'
          && request.resource.data.statut == 'en_attente'
          && request.resource.data.montant is number
          && request.resource.data.montant > 0
          && request.resource.data.montant <= 20000
          && request.resource.data.hasTicket == true)
      );

      // La caisse peut valider, corriger ou rejeter ; le client peut annuler sa commande en attente sans altérer les autres données
      allow update: if isCaisse() || (
        request.auth != null
        && resource.data.clientId == request.auth.uid
        && resource.data.statut == 'en_attente'
        && request.resource.data.statut == 'annule'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'cancelledAt'])
      );
      allow delete: if isCaisse() || (
        request.auth != null
        && resource.data.clientId == request.auth.uid
        && resource.data.statut == 'en_attente'
      );
    }

    match /tickets/{id} {
      allow read: if request.auth != null &&
        (resource.data.clientId == request.auth.uid || isCaisse());
      
      // Limite de taille stricte (< 1 Mo) pour empêcher le blocage de Firestore
      allow create: if request.auth != null
                    && request.resource.data.clientId == request.auth.uid
                    && request.resource.data.img is string
                    && request.resource.data.img.size() < 1000000;
      allow delete: if isCaisse() || (
        request.auth != null
        && resource.data.clientId == request.auth.uid
      );
    }
  }
}
