rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function isCaisse() {
      return request.auth != null &&
        get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'caisse';
    }

    // Profils : chaque client crée le sien (role client uniquement)
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isCaisse());
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.role == 'client';
      allow update: if isCaisse();
    }

    // Mouvements : dépôts / commandes
    match /transactions/{id} {
      allow read: if request.auth != null &&
        (resource.data.clientId == request.auth.uid || isCaisse());
      allow create: if request.auth != null && (
        isCaisse() ||
        (request.resource.data.clientId == request.auth.uid
          && request.resource.data.type == 'commande'
          && request.resource.data.statut == 'en_attente'));
      allow update: if isCaisse();
    }

    // Photos des tickets (même id que la transaction)
    match /tickets/{id} {
      allow read: if request.auth != null &&
        (resource.data.clientId == request.auth.uid || isCaisse());
      allow create: if request.auth != null && request.resource.data.clientId == request.auth.uid;
    }

    // Règles existantes préservées pour le restaurant
    function isSystemFrozen() {
      return exists(/databases/$(db)/documents/system/config)
        && get(/databases/$(db)/documents/system/config).data.frozen == true;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /tables/{tableId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /waiters_calls/{callId} {
      allow create: if request.auth != null && !isSystemFrozen();
      allow read: if request.auth != null;
      allow update: if request.auth != null && !isSystemFrozen();
      allow delete: if isAdmin();
    }

    match /pre_orders/{orderId} {
      allow create: if request.auth != null && !isSystemFrozen();
      allow read: if request.auth != null;
      allow update: if request.auth != null && !isSystemFrozen();
      allow delete: if isAdmin();
    }

    match /system/{document=**} {
      allow read, write: if true;
    }
  }
}
