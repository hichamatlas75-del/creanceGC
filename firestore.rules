rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function isCaisse() {
      return request.auth != null &&
        get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'caisse';
    }

    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isCaisse());
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.role == 'client';
      allow update: if isCaisse();
    }

    match /transactions/{id} {
      allow read: if request.auth != null &&
        (resource.data.clientId == request.auth.uid || isCaisse());
      
      // Sécurisation stricte de la création : contrôle du type, statut, et montant
      allow create: if request.auth != null && (
        isCaisse() ||
        (request.resource.data.clientId == request.auth.uid
          && request.resource.data.type == 'commande'
          && request.resource.data.statut == 'en_attente'
          && request.resource.data.montant is number
          && request.resource.data.montant > 0
          && request.resource.data.montant <= 20000
          && request.resource.data.hasTicket == true)
      );

      // Seule la caisse peut valider ou rejeter
      allow update: if isCaisse();
      allow delete: if isCaisse();
    }

    match /tickets/{id} {
      allow read: if request.auth != null &&
        (resource.data.clientId == request.auth.uid || isCaisse());
      
      // Limite de taille stricte (< 1 Mo) pour empêcher le blocage de Firestore
      allow create: if request.auth != null
                    && request.resource.data.clientId == request.auth.uid
                    && request.resource.data.img is string
                    && request.resource.data.img.size() < 1000000;
      allow delete: if isCaisse();
    }
  }
}
